# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

post_integrate do |installer|
  # FirebaseFirestoreInternal is built and linked as a static library. With
  # modular headers CocoaPods 1.16 also emits a redundant weak-framework flag,
  # which makes ld search for a framework that does not exist.
  support_files = installer.sandbox.root.join('Target Support Files', 'Pods-DeliveryRiderApp')
  Dir.glob(support_files.join('Pods-DeliveryRiderApp.*.xcconfig')).each do |xcconfig|
    contents = File.read(xcconfig)
    File.write(xcconfig, contents.gsub(' -weak_framework "FirebaseFirestoreInternal"', ''))
  end
end

target 'DeliveryRiderApp' do
  config = use_native_modules!

  # Firebase's Swift pods need module maps for these Objective-C dependencies.
  # Keep this scoped: global modular headers cause duplicate React Native modules.
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # FirebaseAuth is a Swift pod, but RNFirebase's Objective-C umbrella import
    # expects its generated compatibility header in CocoaPods' public headers.
    # Publish it after FirebaseAuth compiles so dependent RNFB targets can see it.
    firebase_auth_target = installer.pods_project.targets.find { |target| target.name == 'FirebaseAuth' }
    if firebase_auth_target && !firebase_auth_target.shell_script_build_phases.any? { |phase| phase.name == '[RNFirebase] Expose FirebaseAuth Swift header' }
      phase = firebase_auth_target.new_shell_script_build_phase('[RNFirebase] Expose FirebaseAuth Swift header')
      phase.shell_script = 'ln -sf "${DERIVED_SOURCES_DIR}/FirebaseAuth-Swift.h" "${PODS_ROOT}/Headers/Public/FirebaseAuth/FirebaseAuth-Swift.h"'
    end

  end
end
